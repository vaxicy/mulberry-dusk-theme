{
  "manifest_version": 3,
  "name": "Mulberry Dusk Theme",
  "version": "1.0.0",
  "description": "A deep plum Chrome theme with mauve, rose and a pale pink New Tab Page.",
  "icons": {
    "128": "logo/logo.png"
  },
  "theme": {
    "colors": {
      "frame":                        [84, 8, 99],
      "frame_inactive":               [95, 16, 108],
      "toolbar":                      [105, 33, 111],
      "tab_text":                     [255, 211, 213],
      "bookmark_text":                [255, 211, 213],
      "ntp_background":               [254, 226, 227],
      "ntp_text":                     [84, 8, 99],
      "ntp_link":                     [122, 50, 104],
      "ntp_header":                   [228, 155, 166],
      "button_background":            [228, 155, 166],
      "button_background_secondary":  [146, 72, 122],
      "omnibox_background":           [253, 237, 238],
      "toolbar_button_icon":          [255, 211, 213]
    },
    "properties": {
      "ntp_button_background":    [146, 72, 122],
      "ntp_button_hover":         [126, 58, 102],
      "ntp_logo_alternate":       1,
      "ntp_single_row_shortcuts": true
    },
    "color_scheme": "light",
    "default_color_scheme": "light"
  }
}
